{
  "name": "mochi-ai-chatbot",
  "version": "0.1.0",
  "description": "Mochi \u2014 an open-source AI chatbot for Discord, Telegram, Slack and the web, powered by Flatkey. Memory, search, vision and a cost-control dashboard.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/index.ts",
    "mock": "tsx test/mock-flatkey.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "flatkey",
    "chatbot",
    "discord-bot",
    "telegram-bot",
    "slack-bot",
    "ai",
    "llm",
    "memory"
  ],
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flatkey-ai/Mochi-ai-chatbot.git"
  },
  "homepage": "https://flatkey.ai"
}
