# ── Flatkey (required) ─────────────────────────────────────────────
# Mochi runs on Flatkey: one key for every model she needs (chat, vision,
# search, memory). Official models. Better prices.
#  • Save money: mainstream models are at least 20% below official pricing,
#    and failed calls cost $0.
#  • Save time: one key, one balance, one bill instead of an account per provider.
# You can also skip this and bind the key in the dashboard (Flatkey API key page).
# Create your key (sign up first if needed):
# https://console.flatkey.ai/keys?utm_source=mochi_bot&utm_medium=local_deploy&utm_campaign=mochi&utm_content=env_example
FLATKEY_API_KEY=

# ── Dashboard ──────────────────────────────────────────────────────
PORT=3000
# Password for the dashboard at http://localhost:3000/dashboard
ADMIN_TOKEN=change-me
# Public URL of this server (used by the web widget snippet)
PUBLIC_URL=http://localhost:3000

# ── Channels (optional) ───────────────────────────────────────────
# Connect Discord / Telegram / Slack / QQ per bot in the dashboard (bot → Channels).
# Tokens set here still work and apply to your first bot.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# QQ official bot (q.qq.com → 开发管理): AppID + AppSecret
QQ_APP_ID=
QQ_APP_SECRET=

# Where Mochi keeps bots, memory, knowledge and secrets
DATA_DIR=./data
