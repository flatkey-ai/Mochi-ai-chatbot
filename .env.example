# ── Flatkey (required) ─────────────────────────────────────────────
# Get a key at https://console.flatkey.ai/keys
FLATKEY_API_KEY=
FLATKEY_BASE_URL=https://router.flatkey.ai/v1

# ── Dashboard ──────────────────────────────────────────────────────
PORT=3000
# Password for the dashboard at http://localhost:3000/dashboard
ADMIN_TOKEN=change-me
# Public URL of this server (used by the web widget snippet)
PUBLIC_URL=http://localhost:3000

# ── Platforms (fill in the ones you want; leave others empty) ─────
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Slack uses Socket Mode: an app-level token (xapp-) + bot token (xoxb-)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Where Mochi keeps its memory database and settings
DATA_DIR=./data
